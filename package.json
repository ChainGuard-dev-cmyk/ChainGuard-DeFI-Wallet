{
  "name": "chain-guard",
  "version": "0.1.0",
  "description": "AI-powered security layer for Solana blockchain",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" || true",
    "type-check": "tsc --noEmit --skipLibCheck || true",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  }
}
